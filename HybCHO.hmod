CHO.mlm.x(7).min= 0;
CHO.mlm.x(7).max= 1366.103;
CHO.mlm.x(8).id = 'anninp8';
CHO.mlm.x(8).val= 'Induc';
CHO.mlm.x(8).min= 0;
CHO.mlm.x(8).max= 1.0;
CHO.mlm.ny = 7;
CHO.mlm.y(1).id = 'mu';
CHO.mlm.y(1).val= 'rann1';
CHO.mlm.y(1).min= 0;
CHO.mlm.y(1).max= NaN;
CHO.mlm.y(2).id = 'vGLC';
CHO.mlm.y(2).val= 'rann2';
CHO.mlm.y(2).min= 0;
CHO.mlm.y(2).max= NaN;
CHO.mlm.y(3).id = 'vLAC';
CHO.mlm.y(3).val= 'rann3';
CHO.mlm.y(3).min= 0;
CHO.mlm.y(3).max= NaN;
CHO.mlm.y(4).id = 'vGLN';
CHO.mlm.y(4).val= 'rann4';
CHO.mlm.y(4).min= 0;
CHO.mlm.y(4).max= NaN;
CHO.mlm.y(5).id = 'vGLU';
CHO.mlm.y(5).val= 'rann5';
