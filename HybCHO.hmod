CHO.mlm.options={'hidden nodes', [7]};
CHO.mlm.layer=1;
CHO.mlm.xfun=str2func('autoA_hybmod_anninp');
CHO.mlm.yfun=str2func('autoA_hybmod_rann');
CHO.symbolic='full-symbolic';
CHO.symbolic='semi-symbolic';
CHO.datasource=3;
CHO.datafun=@CHO;
%training configuration
CHO.mode=1;
CHO.method=1;
CHO.jacobian=1;
CHO.hessian=0;
CHO.derivativecheck='off';
CHO.niter=400;
CHO.niteroptim=1;
CHO.nstep=1;
CHO.display='off';
CHO.bootstrap=0;
CHO.nensemble=1;
CHO.crossval=1;

end